{
  "name": "Booking",
  "type": "object",
  "properties": {
    "holding_id": {
      "type": "string",
      "title": "Holding ID"
    },
    "client_name": {
      "type": "string",
      "title": "Client Name"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "pending",
        "cancelled"
      ],
      "title": "Status",
      "default": "confirmed"
    }
  },
  "required": [
    "holding_id",
    "client_name",
    "start_date",
    "end_date"
  ]
}